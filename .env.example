# --- Database (koi ek; DATABASE_URL sabse pehle use hota hai) ---
# Supabase: Project > Connect > "Session pooler" wali URI (password bhar ke)
DATABASE_URL=
# (purana) MongoDB
MONGO_URI=
# Dono khali = local data/ folder

# --- App ---
APP_URL=            # QR me jaane wala public URL, jaise https://maswer-attend.onrender.com
IT_ID=IT001          # pehla IT login (sirf tab bante jab koi IT user na ho)
IT_PASSWORD=        # IT ka password — zaroor set karo
ADMIN_PASSWORD=     # khali = admin ka mobile number hi password rahega
EDIT_PIN=011216     # badal do!
SESSION_SECRET=     # koi lamba random text
PORT=3000

# --- Employee documents (Supabase Storage). Leave empty = local data/uploads folder ---
SUPABASE_URL=            # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=    # service_role key (server only!)
SUPABASE_BUCKET=hr-documents
